# Copiá este archivo como .env.local y ajustá la dirección de la API.
# Emulador de Android: http://10.0.2.2:8000/api
# Celular real: http://IP-DE-TU-PC:8000/api (la API debe correr con: php artisan serve --host=0.0.0.0)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Dirección del servicio de verificación (carpeta verificacion-app).
# Emulador: http://10.0.2.2:3001 — Celular real: http://IP-DE-TU-PC:3001
EXPO_PUBLIC_VERIFICACION_URL=http://10.0.2.2:3001

EXPO_PUBLIC_HORAS_RECORDATORIO_FIRMA=0.02
EXPO_PUBLIC_HORAS_SIN_INGRESAR=0.04